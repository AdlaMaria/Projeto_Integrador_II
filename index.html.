<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PainelFila Escolar</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            margin: 0;
            padding: 30px;
            text-align: center;
        }

        h1 {
            margin-bottom: 10px;
        }

        .container {
            max-width: 800px;
            margin: auto;
        }

        .painel {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-top: 20px;
            box-shadow: 0 2px 8px #ccc;
        }

        .senha-atual {
            font-size: 50px;
            font-weight: bold;
            margin: 20px;
        }

        button {
            padding: 12px 18px;
            margin: 5px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            opacity: 0.85;
        }

        .fila {
            text-align: left;
            margin-top: 20px;
        }

        li {
            margin: 8px 0;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>PainelFila Escolar</h1>
        <p>Sistema de organização e controle de filas</p>

        <div class="painel">

            <h2>Senha chamada</h2>

            <div id="senhaAtual" class="senha-atual">
                ---
            </div>

            <button onclick="retirarSenha()">
                Retirar senha
            </button>

            <button onclick="chamarProxima()">
                Chamar próxima senha
            </button>

            <button onclick="repetirSenha()">
                Repetir senha
            </button>

            <button onclick="finalizarAtendimento()">
                Finalizar atendimento
            </button>

        </div>

        <div class="painel fila">

            <h2>Fila de espera</h2>

            <ul id="fila">
                <li>Nenhuma senha aguardando.</li>
            </ul>

        </div>

    </div>

    <script>

        let fila = JSON.parse(localStorage.getItem("fila")) || [];
        let numeroSenha = Number(localStorage.getItem("numeroSenha")) || 0;
        let senhaAtual = localStorage.getItem("senhaAtual") || null;

        function salvarDados() {
            localStorage.setItem("fila", JSON.stringify(fila));
            localStorage.setItem("numeroSenha", numeroSenha);
            localStorage.setItem("senhaAtual", senhaAtual || "");
        }

        function atualizarTela() {

            const elementoSenha = document.getElementById("senhaAtual");
            const elementoFila = document.getElementById("fila");

            elementoSenha.textContent = senhaAtual || "---";

            elementoFila.innerHTML = "";

            if (fila.length === 0) {
                const item = document.createElement("li");
                item.textContent = "Nenhuma senha aguardando.";
                elementoFila.appendChild(item);
                return;
            }

            fila.forEach(function(senha) {

                const item = document.createElement("li");

                item.textContent = senha;

                elementoFila.appendChild(item);
            });
        }

        function retirarSenha() {

            numeroSenha++;

            const novaSenha = "A" + String(numeroSenha).padStart(3, "0");

            fila.push(novaSenha);

            salvarDados();
            atualizarTela();

            alert("Sua senha é " + novaSenha);
        }

        function chamarProxima() {

            if (fila.length === 0) {
                alert("Não há senhas aguardando.");
                return;
            }

            senhaAtual = fila.shift();

            salvarDados();
            atualizarTela();
        }

        function repetirSenha() {

            if (!senhaAtual) {
                alert("Nenhuma senha foi chamada.");
                return;
            }

            alert("Repetindo a senha " + senhaAtual);
        }

        function finalizarAtendimento() {

            if (!senhaAtual) {
                alert("Não há atendimento em andamento.");
                return;
            }

            alert("Atendimento da senha " + senhaAtual + " finalizado.");

            senhaAtual = null;

            salvarDados();
            atualizarTela();
        }

        atualizarTela();

    </script>

</body>
</html>
